---
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, contact } from '../content/site';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** 'home' enables the intro and the transparent header over the hero. */
  variant?: 'home' | 'page';
  /** Landing-page section to highlight in the navigation on inner pages. */
  section?: string;
  type?: 'website' | 'article' | 'profile';
}

const { title, description = site.description, variant = 'page', section, type = 'website' } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(site.ogImage), Astro.site);
const isHome = variant === 'home';

// Brand Midnight Navy (#111B29) for the browser UI; meta tags cannot read CSS variables.
const themeColor = '#111B29';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL(url('/'), Astro.site).href,
  jobTitle: 'Data Scientist',
  email: `mailto:${contact.email}`,
  nationality: ['Portuguese', 'Brazilian'],
  address: { '@type': 'PostalAddress', addressCountry: 'PT' },
  sameAs: [contact.linkedin, contact.github],
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    {
      isHome && (
        <script is:inline>
          (function () {
            var root = document.documentElement;
            try {
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              if (location.hash || sessionStorage.getItem('do-intro-seen')) return;
              sessionStorage.setItem('do-intro-seen', '1');
              root.setAttribute('data-intro', 'play');
              var done = function () { root.setAttribute('data-intro', 'done'); };
              document.addEventListener('animationend', function (event) {
                if (event.animationName.indexOf('intro-curtain') !== -1) done();
              });
              window.addEventListener('keydown', done, { once: true });
              window.addEventListener('pointerdown', done, { once: true });
            } catch (error) {
              root.removeAttribute('data-intro');
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader variant={isHome ? 'overlay' : 'solid'} section={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
