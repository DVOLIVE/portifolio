---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <p class="mono-label not-found__code">404</p>
      <h1 id="not-found-title">This page doesn’t exist.</h1>
      <p class="not-found__text">The link may be out of date, or the project may not be published yet.</p>
      <Button href="/" icon="arrow-left" iconPosition="start">Back to the portfolio</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 70vh;
    min-height: 70svh;
    align-items: center;
    background: var(--surface-halo), var(--color-canvas);
  }
  .not-found__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-stack-m);
    padding-block: var(--space-section);
  }
  .not-found__code { color: var(--color-accent); }
  .not-found__text { color: var(--color-text-muted); }
</style>
