---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExpertiseCard from '../components/ExpertiseCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import EducationCard from '../components/EducationCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { about, expertiseSection, experienceSection, educationSection } from '../content/profile';
import { categories } from '../content/expertise';
import { experiences } from '../content/experience';
import { educationTimeline } from '../lib/content';
---

<BaseLayout variant="home" type="profile">
  <Intro />
  <Hero />

  <!-- About -->
  <section class="band" id="about" aria-labelledby="about-title">
    <div class="container">
      <SectionHeading id="about-title" title={about.title} align="split">
        <div class="about__text">
          <p class="about__lead">{about.lead}</p>
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </SectionHeading>
    </div>
  </section>

  <!-- Expertise -->
  <section class="band" id="expertise" aria-labelledby="expertise-title">
    <div class="container band__stack">
      <SectionHeading
        id="expertise-title"
        title={expertiseSection.title}
        subline={expertiseSection.subline}
        align="center"
      />
      <ul class="card-grid" role="list">
        {categories.map((category) => <li class="reveal"><ExpertiseCard category={category} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Experience -->
  <section class="band band--deep" id="experience" aria-labelledby="experience-title">
    <div class="container band__stack">
      <SectionHeading
        id="experience-title"
        title={experienceSection.title}
        subline={experienceSection.subline}
      />
      <ul class="card-grid" role="list">
        {experiences.map((experience) => <li class="reveal"><ExperienceCard experience={experience} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Education -->
  <section class="band" id="education" aria-labelledby="education-title">
    <div class="container band__stack">
      <SectionHeading
        id="education-title"
        title={educationSection.title}
        subline={educationSection.subline}
        align="center"
      />
      <ul class="masonry" role="list">
        {educationTimeline().map((record, i) => <li class="masonry__item"><EducationCard record={record} variant={i % 2 === 0 ? 'outline' : 'filled'} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <ContactCTA />
</BaseLayout>

<style>
  .band { padding-block: var(--space-section); }
  /* No rules between bands: the deep band fades in from the canvas and back out. */
  .band--deep {
    background: linear-gradient(
      to bottom,
      var(--color-canvas),
      var(--color-canvas-deep) var(--band-blend),
      var(--color-canvas-deep) calc(100% - var(--band-blend)),
      var(--color-canvas)
    );
  }
  .band__stack {
    display: grid;
    gap: var(--space-stack-xl);
  }

  /* About: headline left and text right */
  .about__text {
    display: grid;
    gap: var(--space-stack-m);
    max-width: var(--layout-measure);
    color: var(--color-text-muted);
  }
  .about__lead {
    color: var(--color-text);
    font-size: var(--font-size-lead);
  }

  .card-grid {
    display: grid;
    gap: var(--space-grid);
    list-style: none;
  }

  .masonry {
    columns: 1;
    column-gap: var(--space-grid);
    list-style: none;
  }
  .masonry__item {
    break-inside: avoid;
    margin-block-end: var(--space-grid);
  }

  @media (--bp-tablet) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .masonry { columns: 2; }
  }

  @media (--bp-desktop) {
    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .masonry { columns: 3; }
  }

  /* Subtle entrance as cards scroll into view — CSS only, progressive */
  @supports (animation-timeline: view()) {
    @media (--motion-ok) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }
</style>
