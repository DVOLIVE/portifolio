---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Metric from '../components/Metric.astro';
import ExpertiseCard from '../components/ExpertiseCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import EducationCard from '../components/EducationCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { about, expertiseSection, experienceSection, educationSection } from '../content/profile';
import { categories } from '../content/expertise';
import { experiences } from '../content/experience';
import { education } from '../content/education';
---

<BaseLayout variant="home" type="profile">
  <Intro />
  <Hero />

  <!-- 01 / About -->
  <section class="band band--about" id="about" aria-labelledby="about-title">
    <div class="container">
      <SectionHeading id="about-title" number={about.number} eyebrow={about.eyebrow} title={about.title} align="split">
        <div class="about__text">
          <p class="about__lead">{about.lead}</p>
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </SectionHeading>
      <div class="about__metrics">
        <dl class="metrics">
          {about.metrics.map((metric) => <Metric value={metric.value} label={metric.label} />)}
        </dl>
        <p class="about__note">{about.metricsNote}</p>
      </div>
    </div>
  </section>

  <!-- 02 / Expertise -->
  <section class="band" id="expertise" aria-labelledby="expertise-title">
    <div class="container band__stack">
      <SectionHeading
        id="expertise-title"
        number={expertiseSection.number}
        eyebrow={expertiseSection.eyebrow}
        title={expertiseSection.title}
        subline={expertiseSection.subline}
        align="center"
      />
      <ul class="card-grid" role="list">
        {categories.map((category) => <li class="reveal"><ExpertiseCard category={category} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 03 / Experience -->
  <section class="band band--deep" id="experience" aria-labelledby="experience-title">
    <div class="container band__stack">
      <SectionHeading
        id="experience-title"
        number={experienceSection.number}
        eyebrow={experienceSection.eyebrow}
        title={experienceSection.title}
        subline={experienceSection.subline}
      />
      <ul class="card-grid" role="list">
        {experiences.map((experience) => <li class="reveal"><ExperienceCard experience={experience} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 04 / Education -->
  <section class="band" id="education" aria-labelledby="education-title">
    <div class="container band__stack">
      <SectionHeading
        id="education-title"
        number={educationSection.number}
        eyebrow={educationSection.eyebrow}
        title={educationSection.title}
        subline={educationSection.subline}
        align="center"
      />
      <ul class="masonry" role="list">
        {education.map((record, i) => <li class="masonry__item"><EducationCard record={record} variant={i % 2 === 0 ? 'outline' : 'filled'} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 05 / Contact -->
  <ContactCTA />
</BaseLayout>

<style>
  .band {
    padding-block: var(--space-section);
    border-block-start: var(--border-hairline);
  }
  .band--deep { background: var(--color-canvas-deep); }
  .band__stack {
    display: grid;
    gap: var(--space-stack-xl);
  }

  /* About: bordered editorial band, headline left and text right */
  .band--about { border-block-end: var(--border-hairline); }
  .about__text {
    display: grid;
    gap: var(--space-stack-m);
    max-width: var(--layout-measure);
    color: var(--color-text-muted);
  }
  .about__lead {
    color: var(--color-text);
    font-size: var(--font-size-lead);
  }
  .about__metrics {
    display: grid;
    gap: var(--space-stack-m);
    margin-block-start: var(--space-stack-xl);
  }
  .metrics {
    display: grid;
    gap: var(--space-grid);
    margin: 0;
  }
  .about__note {
    max-width: var(--layout-measure);
    color: var(--color-text-subtle);
    font-size: var(--font-size-small);
  }

  .card-grid {
    display: grid;
    gap: var(--space-grid);
    list-style: none;
  }

  .masonry {
    columns: 1;
    column-gap: var(--space-grid);
    list-style: none;
  }
  .masonry__item {
    break-inside: avoid;
    margin-block-end: var(--space-grid);
  }

  @media (--bp-tablet) {
    .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .masonry { columns: 2; }
  }

  @media (--bp-desktop) {
    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .masonry { columns: 3; }
  }

  /* Subtle entrance as cards scroll into view — CSS only, progressive */
  @supports (animation-timeline: view()) {
    @media (--motion-ok) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }
</style>
