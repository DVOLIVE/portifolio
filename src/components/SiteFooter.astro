---
import { site, contact } from '../content/site';

/* One row as tall as the header, so the home page's closing statement sits
   centred between the two. Below desktop the identity keeps name and year. */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide site-footer__inner mono-label">
    <p class="site-footer__identity">
      <span>{site.name}</span>
      <span class="site-footer__extra">Professional portfolio</span>
      <span>© {year}</span>
      <span class="site-footer__extra">{site.location}</span>
    </p>
    <ul class="site-footer__links" role="list">
      <li><a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a></li>
      <li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-hairline);
    background: var(--color-canvas-deep);
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-inline-s);
    min-height: calc(var(--layout-footer-height) - var(--border-width));
    color: var(--color-text-subtle);
  }
  .site-footer__identity {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2xs);
    min-width: 0;
  }
  .site-footer__identity > span + span::before {
    content: '·';
    content: '·' / ''; /* decorative: not read aloud */
    margin-inline-end: var(--space-2xs);
  }
  .site-footer__extra { display: none; }
  .site-footer__links {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-inline-s);
    list-style: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--a11y-min-target);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a:hover { color: var(--color-accent-hover); }

  @media (--bp-tablet) {
    .site-footer__inner,
    .site-footer__links { gap: var(--space-inline-m); }
  }
  @media (--bp-desktop) {
    .site-footer__extra { display: inline; }
  }
</style>
