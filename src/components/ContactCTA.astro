---
import Icon from './Icon.astro';
import RibbonField from './RibbonField.astro';
import SectionHeading from './SectionHeading.astro';
import { contactSection } from '../content/profile';
import { contact } from '../content/site';

const actions = [
  { icon: 'linkedin', label: contactSection.actions.linkedin, detail: contact.linkedin.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, ''), href: contact.linkedin, external: true },
  { icon: 'github', label: contactSection.actions.github, detail: contact.github.replace(/^https:\/\//, ''), href: contact.github, external: true },
  { icon: 'mail', label: contactSection.actions.email, detail: contact.email, href: `mailto:${contact.email}`, external: false },
] as const;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <RibbonField />
  <div class="container contact__inner">
    <div class="contact__statement">
      <SectionHeading
        id="contact-title"
        title={contactSection.title}
        subline={contactSection.subline}
        align="center"
      />
    </div>
    <ul class="contact__actions" role="list">
      {
        actions.map((action) => (
          <li>
            <a
              class="contact__action"
              href={action.href}
              target={action.external ? '_blank' : undefined}
              rel={action.external ? 'noopener noreferrer' : undefined}
            >
              <Icon name={action.icon} />
              <span class="contact__label">{action.label}</span>
              <span class="contact__detail">{action.detail}</span>
              {action.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The hero's light ribbons again, set lower so they glow behind the cards */
  .contact {
    --ribbon-offset-y: var(--contact-ribbon-offset-y);
    --ribbon-focus-x: var(--contact-ribbon-focus-x);
    --ribbon-focus-y: var(--contact-ribbon-focus-y);
    --ribbon-overlay: var(--contact-ribbon-overlay);
    --ribbon-fallback: var(--contact-ribbon-fallback);
    position: relative;
    isolation: isolate;
    /* The closing screen fills the space between the header and the footer, so
       at the end of the page it is all that shows, and nothing from the band
       above peeks out. */
    display: grid;
    min-height: calc(100vh - var(--layout-header-height) - var(--layout-footer-height));
    min-height: calc(100svh - var(--layout-header-height) - var(--layout-footer-height));
    padding-block: var(--space-l-xl);
    background: var(--color-canvas);
  }
  /* The statement sits in the middle of the screen and the actions hang below
     it: equal rows above and below, as long as the actions fit in theirs. */
  .contact__inner {
    display: grid;
    grid-template-rows: 1fr auto 1fr;
  }
  .contact__statement { grid-row: 2; }

  .contact__actions {
    display: grid;
    grid-row: 3;
    align-self: start;
    gap: var(--space-grid);
    margin-block-start: var(--space-stack-xl);
    list-style: none;
  }

  .contact__action {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2xs) var(--space-inline-s);
    height: 100%;
    padding: var(--space-s) var(--space-m);
    border: var(--border-width) solid var(--color-canvas-deep);
    border-radius: var(--radius-card);
    background: var(--color-canvas-deep);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--motion-base) var(--motion-ease),
      border-color var(--motion-base) var(--motion-ease),
      background-color var(--motion-base) var(--motion-ease),
      box-shadow var(--motion-base) var(--motion-ease);
  }
  .contact__action :global(.icon) {
    grid-row: span 2;
    color: var(--color-accent);
  }
  .contact__label {
    font-family: var(--font-family-display);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-heading);
  }
  .contact__detail {
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  @media (--bp-tablet) {
    .contact__action { padding: var(--space-m); }
  }

  @media (--bp-desktop) {
    .contact__actions { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (--can-hover) {
    .contact__action:hover {
      transform: translateY(var(--hover-lift));
      border-color: var(--state-active-border);
      background: var(--color-surface);
      box-shadow: var(--elevation-raised);
    }
  }
</style>
