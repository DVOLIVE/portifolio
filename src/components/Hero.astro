---
import Button from './Button.astro';
import { hero } from '../content/profile';
import { site } from '../content/site';

// Split the name into glyphs for the staggered entrance (index → animation delay).
let index = 0;
const words = hero.name.map((word, w) => {
  const chars = [...word];
  if (w === hero.name.length - 1) chars.push('.');
  return chars.map((char) => ({ char, i: index++, dot: char === '.' }));
});
const fullName = `${hero.name.join(' ')}.`;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__visual" aria-hidden="true">
    <div class="hero__fallback"></div>
    <canvas class="hero__canvas" data-ribbons></canvas>
    <div class="hero__overlay"></div>
  </div>

  <div class="container container--wide hero__content">
    <ul class="hero__meta mono-label" role="list">
      {
        hero.meta.map((item, i) => (
          <li class:list={['hero__meta-item', { 'hero__meta-item--status': i === hero.meta.length - 1 }]}>{item}</li>
        ))
      }
    </ul>

    <h1 class="hero__title" id="hero-title">
      <span class="sr-only">{fullName}</span>
      <span class="hero__name" aria-hidden="true">
        {
          words.map((word) => (
            <span class="hero__word">
              {word.map(({ char, i, dot }) => (
                <span class:list={['glyph', { 'glyph--dot': dot }]} style={`--i: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </h1>

    <div class="hero__footer">
      <div class="hero__copy">
        <p class="hero__role">{hero.role}</p>
        <p class="hero__statement">{hero.statement}</p>
      </div>
      <div class="hero__actions">
        <Button href={hero.primaryCta.href} icon="arrow-right">{hero.primaryCta.label}</Button>
        <Button href={site.cv.href} variant="secondary" icon="download" download={site.cv.fileName}>{site.cv.label}</Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountRibbons } from '../scripts/ribbons';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ribbons]');
  const host = document.querySelector<HTMLElement>('[data-hero]');
  if (canvas && host) {
    try {
      mountRibbons(canvas, host);
    } catch (error) {
      console.warn('[ribbons] disabled:', error);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    margin-block-start: calc(-1 * var(--layout-header-height));
    padding-block: calc(var(--layout-header-height) + var(--space-l)) var(--space-l-2xl);
    overflow: hidden;
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-canvas);
  }
  .hero__fallback,
  .hero__canvas,
  .hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__fallback { background: var(--hero-fallback); }
  .hero__canvas {
    opacity: 0;
    transition: opacity var(--ribbon-fade-in) var(--motion-ease);
  }
  .hero__canvas[data-ready] { opacity: 1; }
  .hero__overlay { background: var(--hero-overlay); }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-stack-l);
    min-width: 0;
  }

  /* Metadata row with a hairline rule; a short Racing Red segment marks its start */
  .hero__meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding-block-start: var(--space-s);
    border-block-start: var(--border-hairline);
    color: var(--color-text-muted);
    list-style: none;
  }
  .hero__meta::before {
    content: '';
    position: absolute;
    inset-block-start: calc(-1 * var(--border-width));
    inset-inline-start: 0;
    width: var(--space-xl);
    border-block-start: var(--border-width) solid var(--color-signal);
  }
  .hero__meta-item--status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text);
  }
  .hero__meta-item--status::before {
    content: '';
    width: var(--space-2xs);
    height: var(--space-2xs);
    border-radius: var(--radius-round);
    background: var(--color-accent);
  }

  .hero__title {
    font-size: var(--hero-display-size);
    font-weight: var(--hero-display-weight);
    line-height: var(--hero-display-leading);
    letter-spacing: var(--hero-display-tracking);
    text-wrap: initial;
  }
  .hero__name { display: block; }
  .hero__word {
    display: block;
    white-space: nowrap;
  }
  .glyph { display: inline-block; }
  .glyph--dot { color: var(--color-accent); }

  @media (--motion-ok) {
    .glyph {
      animation: glyph-in var(--glyph-duration) var(--motion-ease) both;
      animation-delay: calc(var(--hero-delay, 0ms) + var(--i) * var(--glyph-stagger));
    }
    :global(:root[data-intro='play']) .glyph { --hero-delay: var(--intro-curtain-at); }
  }

  @keyframes glyph-in {
    from {
      opacity: 0;
      transform: translateY(var(--glyph-lift));
    }
  }

  .hero__footer {
    display: grid;
    gap: var(--space-stack-l);
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-stack-s);
    max-width: var(--layout-measure-lead);
  }
  .hero__role {
    font-family: var(--font-family-display);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-heading);
    color: var(--color-text);
  }
  .hero__statement {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-s);
  }

  @media (--bp-desktop) {
    .hero__footer {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
