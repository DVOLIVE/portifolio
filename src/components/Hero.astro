---
import Button from './Button.astro';
import RibbonField from './RibbonField.astro';
import { hero } from '../content/profile';
import { site } from '../content/site';

// Split the name into glyphs for the staggered entrance (index → animation delay).
let index = 0;
const words = hero.name.map((word, w) => {
  const chars = [...word];
  if (w === hero.name.length - 1) chars.push('.');
  return chars.map((char) => ({ char, i: index++, dot: char === '.' }));
});
const fullName = `${hero.name.join(' ')}.`;
---

<section class="hero" aria-labelledby="hero-title" data-dock-scene>
  <RibbonField parallax />

  <div class="container container--wide hero__content">
    <div class="hero__rule" aria-hidden="true" data-dock-fade></div>

    <h1 class="hero__title" id="hero-title">
      <span class="sr-only">{fullName}</span>
      <span class="hero__name" aria-hidden="true">
        {
          words.map((word, w) => (
            <span class="hero__word" data-dock-flyer={`name-${w + 1}`}>
              {word.map(({ char, i, dot }) => (
                <span class:list={['glyph', { 'glyph--dot': dot }]} style={`--i: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          ))
        }
      </span>
    </h1>

    <div class="hero__footer">
      <div class="hero__copy" data-dock-fade>
        <p class="hero__role">{hero.role}</p>
        <p class="hero__statement">{hero.statement}</p>
      </div>
      <div class="hero__actions">
        <span class="hero__primary" data-dock-fade>
          <Button href={hero.primaryCta.href} icon="arrow-right">{hero.primaryCta.label}</Button>
        </span>
        <span class="hero__cv" data-dock-flyer="contact">
          <Button href={site.cv.href} variant="secondary" icon="download" download={site.cv.fileName}>{site.cv.label}</Button>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountDock } from '../scripts/dock';

  try {
    mountDock();
  } catch (error) {
    // Fall back to a static header with its wordmark and contact button.
    document.documentElement.removeAttribute('data-dock');
    console.warn('[dock] disabled:', error);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    margin-block-start: calc(-1 * var(--layout-header-height));
    padding-block: calc(var(--layout-header-height) + var(--space-l)) var(--space-l-2xl);
    overflow: hidden;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-stack-l);
    min-width: 0;
  }

  /* Hairline rule above the name; a short Racing Red segment marks its start */
  .hero__rule {
    position: relative;
    border-block-start: var(--border-hairline);
  }
  .hero__rule::before {
    content: '';
    position: absolute;
    inset-block-start: calc(-1 * var(--border-width));
    inset-inline-start: 0;
    width: var(--space-xl);
    border-block-start: var(--border-width) solid var(--color-signal);
  }

  .hero__title {
    font-size: var(--hero-display-size);
    font-weight: var(--hero-display-weight);
    line-height: var(--hero-display-leading);
    letter-spacing: var(--hero-display-tracking);
    text-wrap: initial;
  }
  .hero__name { display: block; }
  .hero__word {
    display: block;
    width: fit-content; /* the box is the text, so the scroll dock can measure it */
    white-space: nowrap;
    transform-origin: 0 0; /* scroll dock scales each line from its top-left */
  }
  .glyph { display: inline-block; }
  .glyph--dot { color: var(--color-accent); }

  @media (--motion-ok) {
    .glyph {
      animation: glyph-in var(--glyph-duration) var(--motion-ease) both;
      animation-delay: calc(var(--hero-delay, 0ms) + var(--i) * var(--glyph-stagger));
    }
    :global(:root[data-intro='play']) .glyph { --hero-delay: var(--intro-curtain-at); }
    /* After the opening (Intro.astro), the copy and actions follow the name in,
       and the rule draws itself (on phones it would show inside the band) */
    :global(:root[data-intro='play']) .hero__footer {
      animation: hero-footer-in calc(2 * var(--motion-enter)) var(--motion-ease) var(--intro-copy-at) both;
    }
    :global(:root[data-intro='play']) .hero__rule {
      animation: hero-rule-in calc(2 * var(--motion-enter)) var(--motion-ease) var(--intro-copy-at) both;
    }
    /* …and the ribbons settle into the opening's slit as its panels part */
    :global(:root[data-intro='play']) .hero :global([data-ribbon-field]) {
      transform-origin: 50% var(--intro-slit);
      animation: hero-depth-in var(--intro-reveal) var(--intro-reveal-ease) var(--intro-reveal-at) both;
    }
  }

  @keyframes hero-rule-in {
    from { clip-path: inset(calc(-2 * var(--border-width)) 100% calc(-2 * var(--border-width)) 0); }
  }

  @keyframes hero-depth-in {
    from { transform: scale(var(--intro-depth-scale)); }
  }

  @keyframes hero-footer-in {
    from {
      opacity: 0;
      transform: translateY(var(--intro-lift));
    }
  }

  @keyframes glyph-in {
    from {
      opacity: 0;
      transform: translateY(var(--glyph-lift));
    }
  }

  .hero__footer {
    display: grid;
    gap: var(--space-stack-l);
    align-items: end;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-stack-s);
    max-width: var(--layout-measure-lead);
  }
  .hero__role {
    font-family: var(--font-family-display);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-heading);
    color: var(--color-text);
  }
  .hero__statement {
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-s);
  }
  /* Wrappers take the scroll dock's animations, so the buttons keep their own hover */
  .hero__primary { display: inline-flex; }
  /* Flies into the header on scroll; opaque so nothing shows through it */
  .hero__cv {
    display: inline-flex;
    border-radius: var(--radius-control);
    background: var(--color-canvas);
    transform-origin: 0 0;
  }

  @media (--bp-desktop) {
    .hero__footer {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
