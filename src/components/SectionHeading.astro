---
interface Props {
  title: string;
  subline?: string;
  id: string;
  /** 'split' puts the slot (intro text) beside the title from desktop up. */
  align?: 'start' | 'center' | 'split';
  level?: 'h1' | 'h2';
}

const { title, subline, id, align = 'start', level = 'h2' } = Astro.props;
const Heading = level;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <Heading class="section-heading__title" id={id}>{title}</Heading>
  {subline && <p class="section-heading__subline">{subline}</p>}
  {Astro.slots.has('default') && <div class="section-heading__aside"><slot /></div>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-stack-m);
  }

  .section-heading__title {
    font-size: var(--font-size-band-title);
    line-height: var(--leading-tight);
    max-width: var(--layout-measure-heading);
  }

  .section-heading__subline {
    max-width: var(--layout-measure-lead);
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  @media (--bp-desktop) {
    .section-heading--split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
    .section-heading--split .section-heading__aside { grid-column: 2; grid-row: 1 / span 2; }
  }

  .section-heading--center {
    justify-items: center;
    text-align: center;
  }

  /* Each band's heading rises in as it scrolls into view — CSS only, progressive */
  @supports (animation-timeline: view()) {
    @media (--motion-ok) {
      .section-heading {
        animation: heading-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
    }
  }
  @keyframes heading-in {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }
</style>
