---
/* Initials-based identity — no third-party logos are used. */
interface Props {
  initials: string;
  label: string;
  size?: 'md' | 'lg';
}

const { initials, label, size = 'md' } = Astro.props;
---

<span class:list={['avatar', `avatar--${size}`]} role="img" aria-label={label}>
  <span aria-hidden="true">{initials}</span>
</span>

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--layout-avatar);
    height: var(--layout-avatar);
    border: var(--border-hairline);
    border-radius: var(--radius-round);
    background: var(--color-canvas-deep);
    color: var(--color-accent-hover);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label-role);
  }
  .avatar--lg {
    width: var(--layout-avatar-lg);
    height: var(--layout-avatar-lg);
  }
</style>
